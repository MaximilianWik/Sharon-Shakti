# Site URL (used for OG meta tags and sitemap)
# Update to your custom domain once live.
NEXT_PUBLIC_SITE_URL=https://sharon-shakti.vercel.app

# --- Google Calendar booking (optional in dev; required for live bookings) ---
# Without these the site runs in MOCK mode: the booking UI works fully,
# availability is simulated, and no real calendar events are created.
#
# Setup: see README.md → "Google Calendar setup".

# Service account email, e.g. booking@your-project.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=

# Service account private key. Keep the literal \n escapes on one line:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# The calendar to read availability from and write bookings to.
# Usually your Google account email, or a dedicated calendar's ID.
GOOGLE_CALENDAR_ID=

# IANA time zone the studio operates in (defaults to Europe/Stockholm).
BOOKING_TIMEZONE=Europe/Stockholm

# Optional: a second calendar to include in free/busy checks (e.g. Sharon's personal calendar).
# Any event on this calendar will block the corresponding booking slot.
# The service account needs at least "See only free/busy" access to this calendar.
GOOGLE_PERSONAL_CALENDAR_ID=

# --- Stripe gift cards (required for gift card purchases) ---
# Create an account at stripe.com → Developers → API keys.
# Webhook: register https://your-domain/api/giftcard/webhook in the Stripe dashboard
# with the event: checkout.session.completed — then paste the signing secret below.

# Secret key (server-side only — never expose to the browser)
STRIPE_SECRET_KEY=

# Webhook signing secret (from Stripe Dashboard → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET=

# Publishable key (reserved for a future embedded form — not used server-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Gmail confirmation emails (optional) ---
# If absent, emails are silently skipped — bookings still complete normally.
#
# Setup: log in to sharonshaktitattoo@gmail.com → Google Account → Security
#   → 2-Step Verification (enable) → App Passwords → create one named "sharon.ink"
#   Paste the 16-character code as GMAIL_APP_PASSWORD.

# The Gmail address emails are sent from (and Sharon's notification is sent to).
GMAIL_USER=sharonshaktitattoo@gmail.com

# 16-character Gmail App Password (not the account password).
GMAIL_APP_PASSWORD=
